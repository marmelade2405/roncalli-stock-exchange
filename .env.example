# Diese Datei nach .env kopieren und Zugangsdaten eintragen.
# Die echte .env wird nicht in Git gespeichert.
ADMIN_PASSWORD=
# Mindestens 32 Zeichen, beispielsweise ein zufälliger Hex-Schlüssel.
SESSION_SECRET=
HOST=0.0.0.0
PORT=3000
STATE_FILE=./data/market.json
# Für Internetbetrieb die vollständige HTTPS-Adresse ohne abschließenden / eintragen.
# Im lokalen Netzwerk leer lassen.
PUBLIC_ORIGIN=
